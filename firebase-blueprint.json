{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User tactical discipline profile, active operator archetype, and custom quotas",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "callsign": { "type": "string", "maxLength": 64 },
        "active_persona": { "type": "string", "enum": ["VADER", "RONALDO", "STARK", "BATMAN"] },
        "target_workout": { "type": "number" },
        "target_study": { "type": "number" },
        "target_reading": { "type": "number" },
        "max_screentime": { "type": "number" },
        "macro_progress": { "type": "number" },
        "updated_at": { "type": "string" }
      },
      "required": ["uid", "active_persona"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily execution telemetry for the 5 discipline pillars and action log history",
      "type": "object",
      "properties": {
        "log_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "persona_id": { "type": "string" },
        "workout_minutes": { "type": "number" },
        "study_minutes": { "type": "number" },
        "reading_pages": { "type": "number" },
        "screen_minutes": { "type": "number" },
        "macro_progress": { "type": "number" },
        "execution_score": { "type": "number" },
        "action_logs": { "type": "array" },
        "updated_at": { "type": "string" }
      },
      "required": ["log_date", "execution_score"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and operator preferences"
    },
    "/users/{userId}/daily_logs/{dateStr}": {
      "schema": "DailyLog",
      "description": "Daily discipline execution logs and timestamped actions"
    }
  }
}
